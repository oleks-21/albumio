# Local development against the Firebase Auth emulator and a local API
# (see the API repo's `npm run dev`). Copy to .env.development.local.
REACT_APP_FIREBASE_API_KEY=demo-key
REACT_APP_FIREBASE_AUTH_DOMAIN=localhost
REACT_APP_FIREBASE_PROJECT_ID=demo-albumio
REACT_APP_FIREBASE_APP_ID=demo-app
REACT_APP_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
REACT_APP_API_URL=http://localhost:5000
REACT_APP_EVENT_ALBUMS=true
