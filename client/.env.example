# Copy to .env.production.local before `npm run build`.
# Firebase web config for project albumio-47641 (Firebase console › Project
# settings › Your apps). These values are public identifiers, not secrets.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=albumio-47641.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=albumio-47641
REACT_APP_FIREBASE_APP_ID=

# API base URL (defaults to the Render deployment).
# REACT_APP_API_URL=https://albumio-backend.onrender.com

# Show the event-album section on the homepage once the feature is live.
# REACT_APP_EVENT_ALBUMS=true
