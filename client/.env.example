# Optional build settings (copy to .env.production.local).

# API base URL (defaults to the Render deployment).
# REACT_APP_API_URL=https://albumio-backend.onrender.com

# Show the event-album section on the homepage once the feature is live.
# (The "Event albums" navigation appears automatically when the API reports
# event albums are on.)
# REACT_APP_EVENT_ALBUMS=true
